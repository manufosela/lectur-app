---
import Layout from '../layouts/Layout.astro';
---

<Layout title="LecturAPP">
  <div class="container">

    <!-- Pantalla de Bienvenida -->
    <div id="welcome-screen" class="welcome-screen">
      <div class="welcome-container">
        <div class="welcome-header">
          <img class="welcome-logo" src="/images/logo64x64.png" alt="LecturAPP" />
          <h1 class="welcome-title">LecturAPP</h1>
          <p class="welcome-subtitle">Biblioteca digital multimedia</p>
        </div>

        <div class="welcome-content">
          <p class="welcome-description">
            Tu biblioteca personal de libros, audiolibros y cómics.
            Lee EPUB, escucha audiolibros y disfruta de tus cómics favoritos
            directamente desde el navegador.
          </p>

          <div class="welcome-features">
            <div class="welcome-feature">
              <span class="feature-icon">📚</span>
              <span>Libros EPUB y PDF</span>
            </div>
            <div class="welcome-feature">
              <span class="feature-icon">🎧</span>
              <span>Audiolibros MP3</span>
            </div>
            <div class="welcome-feature">
              <span class="feature-icon">💬</span>
              <span>Cómics CBZ</span>
            </div>
          </div>

          <button id="enter-btn" class="enter-btn">Entrar a la biblioteca</button>
        </div>
      </div>
    </div>

    <!-- Menú Principal de Categorías -->
    <div id="category-menu" class="category-menu" style="display: none;">
      <div class="category-container">
        <header class="category-header">
          <img class="logo clickable-logo" src="/images/logo64x64.png" alt="LecturAPP" title="Inicio" />
          <h1 class="title">LecturAPP</h1>
          <div class="header-actions">
            <button id="menu-theme-toggle" class="theme-toggle" title="Cambiar tema">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
            </button>
          </div>
        </header>

        <div class="category-content">
          <h2 class="category-title">Selecciona una categoría</h2>
          <div class="category-grid">
            <button class="category-card" data-category="books">
              <div class="category-icon">📚</div>
              <h3>Libros</h3>
              <p class="category-count"><span id="books-count" class="count-loading"></span> disponibles</p>
            </button>

            <button class="category-card" data-category="audiobooks">
              <div class="category-icon">🎧</div>
              <h3>Audiolibros</h3>
              <p class="category-count"><span id="audiobooks-count" class="count-loading"></span> disponibles</p>
            </button>

            <button class="category-card" data-category="comics">
              <div class="category-icon">💬</div>
              <h3>Cómics</h3>
              <p class="category-count"><span id="comics-count" class="count-loading"></span> disponibles</p>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Overlay de carga -->
    <div id="overlay" class="overlay hidden">
      <div class="loader"></div>
      <p>Cargando...</p>
    </div>
  </div>

  <!-- Estilos para logos clicables y loaders de contadores -->
  <style>
    .clickable-logo {
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .clickable-logo:hover {
      opacity: 0.8;
    }

    /* Loader para contadores */
    .count-loading {
      display: inline-block;
      width: 2.5em;
      height: 1em;
      background: linear-gradient(90deg, var(--pico-muted-color) 25%, var(--pico-secondary) 50%, var(--pico-muted-color) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: 4px;
      vertical-align: middle;
    }

    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Cuando el contador tiene valor, quitar la animación */
    .count-loading:not(:empty) {
      background: none;
      animation: none;
      width: auto;
    }
  </style>

  <!-- JavaScript principal de la aplicación -->
  <script type="module" src="/js/app.js" is:inline></script>
</Layout>