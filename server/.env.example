# PostgreSQL
POSTGRES_USER=lecturapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lecturapp

# Node API
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://lecturapp:changeme@postgres:5433/lecturapp

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=changeme_generate_a_random_secret

# NAS mount path (inside container)
NAS_MOUNT_PATH=/mnt/nas

# NAS host path (on the host machine, mapped into container)
NAS_HOST_PATH=/mnt/nas
